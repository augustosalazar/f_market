# Copia este archivo como .env y llena los valores. El .env no va al
# repositorio: cada quien apunta a su propio proyecto.
#
# La app lo lee al compilar:
#   flutter run --dart-define-from-file=.env

# El proyecto de Roble. Se copia de la consola: es lo que aparece en la URL,
# /dashboard/project/<esto>
ROBLE_CONTRACT_ID=

# El host del API de Roble, por ejemplo https://roble-api.<dominio>
ROBLE_BASE_URL=
